# ============================================================
# Frontend Template 通用环境变量（所有模式都会加载，被模式文件覆盖）
#
# 每个键标注：用途 / 是否必填 / 默认值 / 示例 / 取值来源。
# 首次使用：cp .env.example .env（另两份同理，见 README「环境变量」）
#
# 注意：VITE_ 前缀的变量会被 Vite 内联进浏览器产物，等同于公开，
#      不放任何密钥、令牌或内网地址；BROWSER 无前缀，只在 Node 侧生效。
# 相对路径与域名按实际部署填写；真实 .env 已被 .gitignore 忽略。
# ============================================================

# ---------- 应用基础 ----------

# VITE_APP_TITLE：应用标题，构建时替换 index.html 的 <title>。【必填】默认 Frontend Template
# 示例：'Frontend Template'（含空格时用单引号包裹）
# 取值：换成你的项目名；已写进 HTML，改动后必须重新构建才生效
VITE_APP_TITLE='Frontend Template'

# VITE_BASE_URL：应用基础路径，同时作用于静态资源、路由与更新探测地址。【必填】默认 /
# 示例：/ | /admin/
# 取值：部署在域名根目录填 /；部署在子目录必须首尾都带 /（如 /admin/，不是 /admin），否则资源 404
VITE_BASE_URL=/

# ---------- 本地开发服务（仅 vp dev 生效） ----------

# VITE_PORT：开发服务器监听端口。【可选】缺省 5173
# 示例：5173
# 取值：自行指定；避开本地后端端口（nestjs-template 默认 8848），监听地址固定 0.0.0.0
VITE_PORT=5173

# VITE_OPEN：启动后是否自动打开浏览器。【可选】Y | N，缺省不打开（本模板为 Y）
# 示例：Y
# 取值：需要自动开页填 Y；CI 或远程容器里填 N，避免无浏览器环境报错
VITE_OPEN=Y

# BROWSER：自动打开时使用的浏览器（非 VITE_ 前缀，只在 Node 侧读取）。【可选】缺省系统默认浏览器
# 示例：chrome | msedge | firefox | safari | none（none 表示完全不打开）
# 取值：填本机已安装的浏览器标识；要打开系统默认浏览器请注释掉下面一行
BROWSER=chrome

# ---------- 开发代理（仅 vp dev 生效） ----------

# VITE_HTTP_PROXY：是否启用开发代理。【可选】Y | N，缺省 N（本模板为 Y）
# 示例：Y
# 取值：需要联调本地后端填 Y；vp build / vp preview 下不生效，代理规则见 .env.development
VITE_HTTP_PROXY=Y

# VITE_PROXY_LOG：是否打印代理转发日志。【可选】Y | N，缺省 N
# 示例：Y
# 取值：排查 404 / 转发地址错误时开 Y，日常可关；仅在 VITE_HTTP_PROXY=Y 时有输出
VITE_PROXY_LOG=Y

# ---------- 构建 ----------

# VITE_SOURCE_MAP：是否生成 sourcemap。【可选】Y | N，缺省 N
# 示例：N
# 取值：生产默认 N；需要线上排错时可临时开 Y，但会额外产出 .map 并暴露源码结构
VITE_SOURCE_MAP=N

# ---------- 运行时存储与版本更新 ----------

# VITE_STORAGE_PREFIX：localStorage / sessionStorage 的键前缀。【可选】缺省空字符串
# 示例：RA_ | myapp_
# 取值：改成你的项目缩写；与别的项目同域部署时用它隔离存储键，避免互相覆盖
VITE_STORAGE_PREFIX=RA_

# VITE_AUTOMATICALLY_DETECT_UPDATE：是否轮询 index.html 的 buildTime 检测新版本并提示刷新。【可选】Y | N，缺省 N
# 示例：Y
# 取值：仅当 .env.production 的 VITE_USER_NODE_ENV=production 时才启用；依赖 VITE_BASE_URL 能取到 index.html
VITE_AUTOMATICALLY_DETECT_UPDATE=Y

# ---------- 图标 ----------

# VITE_ICON_PREFIX：图标类名前缀（UnoCSS presetIcons 与图标组件共用）。【必填】默认 icon
# 示例：icon（使用处写作 icon-carbon-sun、icon-local-xxx）
# 取值：一般保持 icon；改动后 VITE_ICON_LOCAL_PREFIX 必须以「新前缀-」开头，且全项目图标写法同步改
VITE_ICON_PREFIX=icon

# VITE_ICON_LOCAL_PREFIX：本地 SVG 图标集合前缀，取自 src/assets/svg-icon。【必填】默认 icon-local
# 示例：icon-local（format {VITE_ICON_PREFIX}-{集合名}）
# 取值：必须包含 VITE_ICON_PREFIX；集合名 = 去掉「icon-」后的部分，本模板即 local，改错会导致本地图标全部失效
VITE_ICON_LOCAL_PREFIX=icon-local

# ---------- 开发调试（仅 vp dev 生效） ----------

# VITE_DEVTOOLS_LAUNCH_EDITOR：Vue DevTools 中「打开组件源码」使用的编辑器。【建议必填】缺省会被拼成字符串 undefined 而无法唤起
# 示例：code | cursor | webstorm | /usr/local/bin/code
# 取值：填编辑器命令行名（需在 PATH 中）或绝对路径；该插件只在开发模式生效，构建时被移除
VITE_DEVTOOLS_LAUNCH_EDITOR=code
