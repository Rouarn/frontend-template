# ============================================================
# Frontend Template 开发环境变量（vp dev --mode development 加载）
#
# 每个键标注：用途 / 是否必填 / 默认值 / 示例 / 取值来源。
# 首次使用：cp .env.development.example .env.development
#
# 注意：VITE_ 前缀的变量会被内联进浏览器产物（等同公开），只写地址不写密钥；
#      这里的接口地址只影响开发，生产以 .env.production 为准。
# ============================================================

# ---------- 环境标识 ----------

# VITE_USER_NODE_ENV：业务侧环境标识，决定主题是否缓存、版本更新检测是否启用。【必填】开发固定 development
# 示例：development | production（取值只能是这两者）
# 取值：与文件名对应；它不是 NODE_ENV，不改变打包器行为，只供 import.meta.env 判断
VITE_USER_NODE_ENV=development

# ---------- 路由 ----------

# VITE_ROUTER_MODE：vue-router 历史模式。【可选】默认 hash
# 示例：hash | history | memory（memory 仅测试用）
# 取值：hash 无需服务端配置，静态托管与子目录部署首选；history 需服务端把未命中路径回退到 index.html
VITE_ROUTER_MODE=hash

# ---------- 接口与代理 ----------

# VITE_SERVICE_BASE_URL：接口请求基址（axios baseURL），开发环境走代理前缀。【必填】无默认值
# 示例：/proxy-node | http://127.0.0.1:8848
# 取值：填 VITE_PROXY 里定义的前缀即可；直接填后端绝对地址则绕过代理，需后端放开 CORS
VITE_SERVICE_BASE_URL=/proxy-node

# VITE_PROXY：开发代理映射表，JSON 数组，每项为 [匹配前缀, 目标地址]。【可选】缺省不代理
# 示例：'[["/proxy-node","http://127.0.0.1:8848"]]'
# 取值：前缀需与 VITE_SERVICE_BASE_URL 一致，支持多后端；本地后端（nestjs-template 默认 8848），如需直连线上调试，追加 ["/proxy-remote","https://template.shixian.xyz"]
VITE_PROXY='[["/proxy-node","http://127.0.0.1:8848"]]'
